FROM quay.io/centos/centos:stream9

# Replace the default repo file (metalink-based, unreliable in CI) with
# one that uses direct baseurl mirrors. CRB is enabled here so packages
# like libnbd-devel are available without a separate config-manager call.
COPY centos.repo /etc/yum.repos.d/centos.repo

# Install all Go build dependencies in a single layer
RUN dnf -y update && \
    dnf install -y \
        golang \
        libnbd-devel \
        gcc \
        make \
        git \
        epel-release && \
    dnf install -y upx || echo "UPX not available in EPEL — skipping." && \
    dnf clean all

WORKDIR /code
